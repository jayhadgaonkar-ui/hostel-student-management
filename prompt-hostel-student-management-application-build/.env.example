# Public client configuration. Leave values empty until configured locally.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only credentials. Never expose these values to client-side code.
SUPABASE_SERVICE_ROLE_KEY=
OWNER_USER_ID=

# Comma-separated browser origins allowed by the server.
ALLOWED_ORIGINS=

# Server-only Aadhaar protection secrets. Never expose these values to clients.
AADHAAR_HMAC_SECRET=
AADHAAR_ENCRYPTION_KEY=
